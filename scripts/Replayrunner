from torch.utils.tensorboard import SummaryWriter
import torch
class ReplayRunner:
    def __init__(self, env, log_dir):
        self.env = env
        path = self.env.path
        self.traj = self._get_action(path)
        self.writer = SummaryWriter(log_dir)
        self.timestep = 0
        self.episode_idx = 0
        self.episode_reward = 0

    def step(self):
        obs = self.env.get_observations()
        with torch.inference_mode():
            action = self.policy(obs)
        obs, reward, done, info = self.env.step(action)

        # per-step logging
        self.writer.add_scalar("reward", reward.mean().item(), self.timestep)
        self.writer.add_scalar("action_norm", action.norm().item(), self.timestep)

        self.episode_reward += reward.mean().item()
        self.timestep += 1

        # per-episode logging
        if done.any():
            self.writer.add_scalar("episode_reward", self.episode_reward, self.episode_idx)
            self.writer.add_scalar("episode_length", self.timestep, self.episode_idx)
            self.episode_idx += 1
            self.episode_reward = 0
            self.timestep = 0

        return obs, reward, done, info


    def _get_traj(self):
